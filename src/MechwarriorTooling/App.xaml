<Application x:Class="MechwarriorTooling.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="Window"><Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#E3E9ED"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#253647"/><Setter Property="Foreground" Value="#EDF5FC"/><Setter Property="BorderBrush" Value="#496174"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#192633"/><Setter Property="Foreground" Value="#E3E9ED"/><Setter Property="BorderBrush" Value="#42586C"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="10,5"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#E3E9ED"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="7,5"/><Setter Property="MinWidth" Value="130"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#182431"/><Setter Property="BorderBrush" Value="#344B5E"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="14,7"/></Style>
 </Application.Resources>
</Application>
